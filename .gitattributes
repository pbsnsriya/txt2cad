# One line ending for the whole repository, whatever the operating system of the person committing.
* text=auto eol=lf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webm binary
*.woff binary
*.woff2 binary
*.wasm binary
*.zip binary
*.dwg binary

# Windows scripts need their own line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
